-module({{app}}_body_limit).
-behaviour(nova_plugin).

-export([pre_request/4, post_request/4, plugin_info/0]).

-define(MAX_BYTES, 65536).

%% Refuses a body over max_bytes (default 65536) before anything reads it.
%% A body without content-length (HTTP/1.1 chunked or HTTP/2) has no length
%% up front, so it is refused too. Nova 0.19's nova_request_plugin also caps
%% the body it decodes (max_body_length, default 1 MB), but it reads a body
%% without content-length up to that cap; this plugin refuses one unread,
%% and keeps a lower limit for the routes it is on.
-spec pre_request(cowboy_req:req(), term(), map(), term()) ->
    {ok, cowboy_req:req(), term()} | {stop, cowboy_req:req(), term()}.
pre_request(Req, _Env, Options, State) ->
    Max = maps:get(max_bytes, Options, ?MAX_BYTES),
    case cowboy_req:body_length(Req) of
        Length when is_integer(Length), Length =< Max ->
            {ok, Req, State};
        _ ->
            Headers = #{~"content-type" => ~"application/json"},
            Body = iolist_to_binary(json:encode(#{~"error" => ~"request body too large"})),
            {stop, cowboy_req:reply(413, Headers, Body, Req), State}
    end.

-spec post_request(cowboy_req:req(), term(), map(), term()) -> {ok, cowboy_req:req(), term()}.
post_request(Req, _Env, _Options, State) ->
    {ok, Req, State}.

-spec plugin_info() -> map().
plugin_info() ->
    #{
        title => ~"{{app}}_body_limit",
        version => ~"0.1.0",
        url => ~"https://github.com/novaframework/rebar3_nova",
        authors => [],
        description => ~"Refuses request bodies over max_bytes"
    }.

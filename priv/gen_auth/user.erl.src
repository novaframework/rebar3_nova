-module({{app}}_user).
-behaviour(kura_schema).
-include_lib("kura/include/kura.hrl").

-export([table/0, fields/0, indexes/0]).
-export([registration_changeset/2, password_changeset/2, email_changeset/2, normalize_email/1]).

table() -> ~"users".

fields() ->
    [
        #kura_field{name = id, type = id, primary_key = true, nullable = false},
        #kura_field{name = email, type = string, nullable = false},
        #kura_field{name = hashed_password, type = string, nullable = false},
        #kura_field{name = confirmed_at, type = utc_datetime},
        #kura_field{name = inserted_at, type = utc_datetime},
        #kura_field{name = updated_at, type = utc_datetime},
        #kura_field{name = password, type = string, virtual = true},
        #kura_field{name = password_confirmation, type = string, virtual = true}
    ].

indexes() ->
    [{[email], #{unique => true}}].

registration_changeset(Data, Params) ->
    CS = kura_changeset:cast(?MODULE, Data, Params, [email, password, password_confirmation]),
    CS1 = kura_changeset:validate_required(CS, [email, password]),
    scrub_password(hash_password(validate_password(validate_email(CS1)))).

password_changeset(Data, Params) ->
    CS = kura_changeset:cast(?MODULE, Data, Params, [password, password_confirmation]),
    CS1 = kura_changeset:validate_required(CS, [password]),
    scrub_password(hash_password(validate_password(CS1))).

%% A new address is unconfirmed until nova_auth_confirm confirms it again.
email_changeset(Data, Params) ->
    CS = kura_changeset:cast(?MODULE, Data, Params, [email]),
    CS1 = validate_email(kura_changeset:validate_required(CS, [email])),
    case kura_changeset:get_change(CS1, email) of
        undefined -> CS1;
        _ -> kura_changeset:put_change(CS1, confirmed_at, undefined)
    end.

%% Emails are stored normalised, so the unique index sees one address
%% whatever its case. Normalise a login email the same way before
%% nova_auth_accounts:authenticate/3.
-spec normalize_email(term()) -> {ok, binary()} | error.
normalize_email(Email) when is_binary(Email) ->
    case unicode:characters_to_nfc_binary(Email) of
        Nfc when is_binary(Nfc) -> {ok, string:lowercase(Nfc)};
        _ -> error
    end;
normalize_email(_) ->
    error.

validate_email(CS) ->
    case kura_changeset:get_change(CS, email) of
        undefined ->
            CS;
        Email ->
            case normalize_email(Email) of
                {ok, Normal} ->
                    check_email(drop_unchanged_email(kura_changeset:put_change(CS, email, Normal)));
                error ->
                    kura_changeset:add_error(CS, email, ~"is not valid UTF-8")
            end
    end.

check_email(CS) ->
    CS1 = kura_changeset:validate_format(CS, email, ~"^[^@\\s]+@[^@\\s]+\\z"),
    CS2 = validate_chars(CS1, email, 3, 160),
    kura_changeset:unique_constraint(CS2, email).

drop_unchanged_email(
    #kura_changeset{data = #{email := Email}, changes = #{email := Email} = Changes} = CS
) ->
    CS#kura_changeset{changes = maps:remove(email, Changes)};
drop_unchanged_email(CS) ->
    CS.

validate_password(CS) ->
    CS1 = validate_chars(CS, password, 12, 1024),
    kura_changeset:validate_confirmation(CS1, password).

%% Counted in code points, not bytes (kura_changeset:validate_length/3) or
%% graphemes, which let combining marks make a huge input count as short.
validate_chars(CS, Field, Min, Max) ->
    case kura_changeset:get_change(CS, Field) of
        Value when is_binary(Value) ->
            case unicode:characters_to_list(Value) of
                Chars when is_list(Chars) -> check_chars(CS, Field, length(Chars), Min, Max);
                _ -> kura_changeset:add_error(CS, Field, ~"is not valid UTF-8")
            end;
        _ ->
            CS
    end.

check_chars(CS, Field, Length, Min, _Max) when Length < Min ->
    kura_changeset:add_error(CS, Field, chars_message("should be at least ~B character(s)", Min));
check_chars(CS, Field, Length, _Min, Max) when Length > Max ->
    kura_changeset:add_error(CS, Field, chars_message("should be at most ~B character(s)", Max));
check_chars(CS, _Field, _Length, _Min, _Max) ->
    CS.

chars_message(Format, N) ->
    iolist_to_binary(io_lib:format(Format, [N])).

hash_password(#kura_changeset{valid = true} = CS) ->
    case kura_changeset:get_change(CS, password) of
        undefined ->
            CS;
        Password ->
            kura_changeset:put_change(CS, hashed_password, nova_auth_password:hash(Password))
    end;
hash_password(CS) ->
    CS.

%% A changeset comes back in {error, CS} and can end up in a log or a crash
%% report, so the plaintext does not outlive hashing, valid or not.
scrub_password(#kura_changeset{changes = Changes, params = Params} = CS) ->
    Secret = [password, password_confirmation, ~"password", ~"password_confirmation"],
    CS#kura_changeset{
        changes = maps:without(Secret, Changes), params = maps:without(Secret, Params)
    }.

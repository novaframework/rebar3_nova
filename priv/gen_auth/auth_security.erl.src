-module({{app}}_auth_security).

-export([require_bearer/1, bearer_token/1]).

%% auth_data carries only what handlers need, never the password hash.
-spec require_bearer(cowboy_req:req()) ->
    {true, #{id := term(), email := binary()}} | {false, 401, map(), binary()}.
require_bearer(Req) ->
    case bearer_token(Req) of
        {ok, Token} ->
            case {{app}}_accounts:user_for_token(Token) of
                {ok, #{id := Id, email := Email}} -> {true, #{id => Id, email => Email}};
                {error, _} -> unauthorized(~"invalid or expired token")
            end;
        error ->
            unauthorized(~"missing bearer token")
    end.

%% Bytewise, since the header is attacker-controlled and need not be UTF-8.
-spec bearer_token(cowboy_req:req()) -> {ok, binary()} | error.
bearer_token(Req) ->
    case cowboy_req:header(~"authorization", Req) of
        <<Scheme:6/binary, " ", Token/binary>> ->
            case string:lowercase(binary_to_list(Scheme)) =:= "bearer" andalso is_token(Token) of
                true -> {ok, Token};
                false -> error
            end;
        _ ->
            error
    end.

%% RFC 6750 b64token: at least one token character, then only = padding.
is_token(Token) ->
    case string:trim(binary_to_list(Token), trailing, "=") of
        [] -> false;
        Chars -> lists:all(fun is_token_char/1, Chars)
    end.

is_token_char(C) when C >= $a, C =< $z -> true;
is_token_char(C) when C >= $A, C =< $Z -> true;
is_token_char(C) when C >= $0, C =< $9 -> true;
is_token_char(C) -> lists:member(C, "-._~+/").

unauthorized(Message) ->
    Headers = #{~"content-type" => ~"application/json", ~"www-authenticate" => ~"Bearer"},
    {false, 401, Headers, iolist_to_binary(json:encode(#{~"error" => Message}))}.

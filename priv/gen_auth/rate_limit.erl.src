-module({{app}}_rate_limit).
-behaviour(nova_plugin).

-export([pre_request/4, post_request/4, plugin_info/0, options/0]).
-export([client_ip/1, rate_limit_key/1, check_account/1]).

-define(ACCOUNT_LIMITER, {{app}}_account_rate_limit).

%% Wraps nova_auth_rate_limit, which in nova_auth 0.2.0 needs every option
%% set and replies {stop, Req}, a return Nova does not accept. Once nova_auth
%% ships its own client_ip/1, it replaces the address handling below.
pre_request(Req, Env, Options, State) ->
    case nova_auth_rate_limit:pre_request(Req, Env, maps:merge(options(), Options), State) of
        {stop, Req1} -> {stop, Req1, State};
        Result -> Result
    end.

post_request(Req, _Env, _Options, State) ->
    {ok, Req, State}.

plugin_info() ->
    #{
        title => ~"{{app}}_rate_limit",
        version => ~"0.1.0",
        url => ~"https://github.com/novaframework/nova_auth",
        authors => [],
        description => ~"Rate limits login and registration with nova_auth_rate_limit"
    }.

options() ->
    #{
        limiter => {{app}}_auth_rate_limit,
        limit => 10,
        window => 60000,
        algorithm => sliding_window,
        key_fun => fun ?MODULE:rate_limit_key/1
    }.

%% One bucket per IPv4 address and per IPv6 /64, since a single host
%% usually holds a whole /64.
rate_limit_key(Req) ->
    case client_ip(Req) of
        {A, B, C, D, _, _, _, _} -> {A, B, C, D, 0, 0, 0, 0};
        IP -> IP
    end.

%% The TCP peer, unless it is one of the trusted_proxies in the {{app}} env
%% (addresses or {Address, PrefixLength} ranges, default []). Then the client
%% is the right-most x-forwarded-for address that is not a trusted proxy:
%% entries left of it were written by the client and can be anything.
client_ip(Req) ->
    {Peer, _Port} = cowboy_req:peer(Req),
    Trusted = trusted_proxies(),
    case is_trusted(unmap(Peer), Trusted) of
        true ->
            Hops = binary:split(cowboy_req:header(~"x-forwarded-for", Req, ~""), ~",", [global]),
            forwarded_client(lists:reverse(Hops), unmap(Peer), Trusted);
        false ->
            unmap(Peer)
    end.

forwarded_client([], Peer, _Trusted) ->
    Peer;
forwarded_client([Hop | Hops], Peer, Trusted) ->
    case hop_address(list_to_binary(string:trim(binary_to_list(Hop)))) of
        empty ->
            forwarded_client(Hops, Peer, Trusted);
        {ok, IP} ->
            case is_trusted(unmap(IP), Trusted) of
                true -> forwarded_client(Hops, Peer, Trusted);
                false -> unmap(IP)
            end;
        error ->
            Peer
    end.

%% An address, optionally with a port: 192.0.2.1:8080 or [2001:db8::1]:443.
hop_address(<<>>) ->
    empty;
hop_address(<<"[", Rest/binary>>) ->
    case binary:split(Rest, ~"]") of
        [Address, <<>>] ->
            parse_address(Address, fun inet:parse_ipv6strict_address/1);
        [Address, <<":", Port/binary>>] ->
            with_port(Address, Port, fun inet:parse_ipv6strict_address/1);
        _ ->
            error
    end;
hop_address(Hop) ->
    case binary:split(Hop, ~":", [global]) of
        [Address, Port] -> with_port(Address, Port, fun inet:parse_ipv4strict_address/1);
        _ -> parse_address(Hop, fun inet:parse_strict_address/1)
    end.

with_port(Address, Port, Parse) ->
    case is_port_number(Port) of
        true -> parse_address(Address, Parse);
        false -> error
    end.

is_port_number(<<>>) -> false;
is_port_number(Port) -> [C || <<C>> <= Port, C < $0 orelse C > $9] =:= [].

parse_address(Address, Parse) ->
    case Parse(binary_to_list(Address)) of
        {ok, IP} -> {ok, IP};
        {error, _} -> error
    end.

is_trusted(IP, Trusted) ->
    Bits = address_bits(IP),
    [Range || Range <- Trusted, in_range(Bits, Range)] =/= [].

in_range(Bits, {Size, Prefix}) when bit_size(Bits) =:= Size ->
    Length = bit_size(Prefix),
    case Bits of
        <<Prefix:Length/bitstring, _/bitstring>> -> true;
        _ -> false
    end;
in_range(_Bits, _Range) ->
    false.

%% trusted_proxies as {AddressSize, Prefix} bit ranges, checked once per
%% value of the setting so a mistyped entry fails loudly instead of being
%% skipped.
trusted_proxies() ->
    Setting = application:get_env({{app}}, trusted_proxies, []),
    case persistent_term:get({?MODULE, trusted_proxies}, undefined) of
        {Setting, Ranges} ->
            Ranges;
        _ ->
            Ranges = trusted_ranges(Setting),
            persistent_term:put({?MODULE, trusted_proxies}, {Setting, Ranges}),
            Ranges
    end.

trusted_ranges(Setting) when is_list(Setting) ->
    [trusted_range(Entry) || Entry <- Setting];
trusted_ranges(Setting) ->
    invalid_trusted_proxy(Setting).

trusted_range({Network, Length} = Entry) when is_tuple(Network), is_integer(Length) ->
    case inet:is_ip_address(Network) of
        true ->
            Bits = address_bits(unmap(Network)),
            case Length >= 0 andalso Length =< bit_size(Bits) of
                true -> {bit_size(Bits), prefix(Bits, Length)};
                false -> invalid_trusted_proxy(Entry)
            end;
        false ->
            invalid_trusted_proxy(Entry)
    end;
trusted_range(Address) ->
    case inet:is_ip_address(Address) of
        true ->
            Bits = address_bits(unmap(Address)),
            {bit_size(Bits), Bits};
        false ->
            invalid_trusted_proxy(Address)
    end.

invalid_trusted_proxy(Entry) ->
    erlang:error(
        {invalid_trusted_proxy, Entry,
            "trusted_proxies takes a list of address tuples, such as {10, 0, 0, 2}, "
            "and {Address, PrefixLength} ranges, such as {{10, 1, 0, 0}, 16}"}
    ).

address_bits({A, B, C, D}) -> <<A, B, C, D>>;
address_bits({A, B, C, D, E, F, G, H}) -> <<A:16, B:16, C:16, D:16, E:16, F:16, G:16, H:16>>.

prefix(Bits, Length) ->
    <<Prefix:Length/bitstring, _/bitstring>> = Bits,
    Prefix.

%% ::ffff:a.b.c.d is a.b.c.d.
unmap({0, 0, 0, 0, 0, 16#ffff, AB, CD}) -> {AB bsr 8, AB band 255, CD bsr 8, CD band 255};
unmap(IP) -> IP.

%% A per-account limit on top of the per-address one, so rotating addresses
%% does not buy unlimited guesses at one password. It is generous, 20 per
%% 15 minutes, so failing logins in a victim's name hardly locks them out.
check_account(Email) ->
    case {{app}}_user:normalize_email(Email) of
        {ok, Normalized} -> account_check(Normalized);
        error -> allow
    end.

account_check(Key) ->
    try seki:check(?ACCOUNT_LIMITER, Key) of
        {allow, _} -> allow;
        {deny, #{retry_after := RetryAfterMs}} -> {deny, max(1, RetryAfterMs div 1000)}
    catch
        error:{limiter_not_found, ?ACCOUNT_LIMITER} ->
            ok = new_account_limiter(),
            account_check(Key)
    end.

%% Created on the first login. Two first logins at once can both get here;
%% the second sees already_registered.
new_account_limiter() ->
    Options = #{algorithm => sliding_window, limit => 20, window => 900000},
    case seki:new_limiter(?ACCOUNT_LIMITER, Options) of
        ok -> ok;
        {error, already_registered} -> ok
    end.

-module({{app}}_user_token).
-behaviour(kura_schema).
-include_lib("kura/include/kura.hrl").

-export([table/0, fields/0, indexes/0, associations/0]).

table() -> ~"user_tokens".

fields() ->
    [
        #kura_field{name = id, type = id, primary_key = true, nullable = false},
        #kura_field{name = user_id, type = bigint, nullable = false},
        #kura_field{name = token, type = string, nullable = false},
        #kura_field{name = context, type = string, nullable = false},
        #kura_field{name = family_id, type = string},
        #kura_field{name = used_at, type = utc_datetime},
        #kura_field{name = inserted_at, type = utc_datetime}
    ].

indexes() ->
    [
        {[context, token], #{unique => true}},
        {[user_id], #{}}
    ].

associations() ->
    [
        #kura_assoc{
            name = user,
            type = belongs_to,
            schema = {{app}}_user,
            foreign_key = user_id,
            on_delete = cascade
        }
    ].

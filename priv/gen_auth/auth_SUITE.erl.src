-module({{app}}_auth_SUITE).

-include_lib("common_test/include/ct.hrl").
-include_lib("stdlib/include/assert.hrl").

-export([all/0, init_per_suite/1, end_per_suite/1]).
-export([
    register_login_and_logout/1,
    wrong_password_is_rejected/1,
    short_password_is_rejected/1,
    mismatched_confirmation_is_rejected/1,
    me_needs_a_token/1
]).

all() ->
    [
        register_login_and_logout,
        wrong_password_is_rejected,
        short_password_is_rejected,
        mismatched_confirmation_is_rejected,
        me_needs_a_token
    ].

init_per_suite(Config) ->
    {ok, _} = application:ensure_all_started(inets),
    {ok, _} = application:ensure_all_started({{app}}),
    Config.

end_per_suite(_Config) ->
    ok = application:stop({{app}}).

register_login_and_logout(_Config) ->
    Email = unique_email(),
    {201, #{~"email" := Email}} = post("/api/users", registration(Email, password())),
    {201, #{~"token" := Token}} = post("/api/tokens", #{email => Email, password => password()}),
    ?assertMatch({200, #{~"email" := Email}}, request(get, "/api/me", Token)),
    ?assertMatch({204, _}, request(delete, "/api/tokens", Token)),
    ?assertMatch({401, _}, request(get, "/api/me", Token)).

wrong_password_is_rejected(_Config) ->
    Email = unique_email(),
    {201, _} = post("/api/users", registration(Email, password())),
    ?assertMatch({401, _}, post("/api/tokens", #{email => Email, password => ~"not the password"})).

short_password_is_rejected(_Config) ->
    ?assertMatch(
        {422, #{~"errors" := #{~"password" := [_ | _]}}},
        post("/api/users", registration(unique_email(), ~"short"))
    ).

mismatched_confirmation_is_rejected(_Config) ->
    Body = #{email => unique_email(), password => password(), password_confirmation => ~"other"},
    ?assertMatch(
        {422, #{~"errors" := #{~"password_confirmation" := [_ | _]}}},
        post("/api/users", Body)
    ).

me_needs_a_token(_Config) ->
    ?assertMatch({401, _}, request(get, "/api/me", ~"invalid")).

%% The users stay in the database, so each run needs fresh addresses.
unique_email() ->
    iolist_to_binary([
        ~"user-", binary:encode_hex(crypto:strong_rand_bytes(8), lowercase), ~"@example.com"
    ]).

password() ->
    ~"correct horse battery staple".

registration(Email, Password) ->
    #{email => Email, password => Password, password_confirmation => Password}.

post(Path, Body) ->
    Request = {url(Path), [], "application/json", json:encode(Body)},
    response(httpc:request(post, Request, [], [{body_format, binary}])).

request(Method, Path, Token) ->
    Headers = [{"authorization", "Bearer " ++ binary_to_list(Token)}],
    response(httpc:request(Method, {url(Path), Headers}, [], [{body_format, binary}])).

response({ok, {{_, Status, _}, _Headers, <<>>}}) ->
    {Status, #{}};
response({ok, {{_, Status, _}, _Headers, Body}}) ->
    {Status, json:decode(Body)}.

url(Path) ->
    Cowboy = application:get_env(nova, cowboy_configuration, #{}),
    "http://localhost:" ++ integer_to_list(maps:get(port, Cowboy, 8080)) ++ Path.

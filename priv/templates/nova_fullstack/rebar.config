%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-

{erl_opts, [debug_info]}.
{src_dirs, [{"src", [{recursive, true}]}]}.
{shell, [{config, "./config/dev_sys.config.src"}]}.

{deps, [
    {nova, "~> 0.18"},
    {kura, "~> 2.25"},
    {kura_postgres, "~> 1.1"},
    {arizona_nova, "~> 0.1"},
    {flatlog, "0.1.2"}
]}.

%% Release profiles
{relx, [
    {release, {{{name}}, git}, [
        {{name}},
        sasl
    ]},
    {mode, dev},
    {sys_config_src, "./config/dev_sys.config.src"},
    {vm_args_src, "./config/vm.args.src"},
    {extended_start_script_hooks, [{pre_start, [{custom, "hooks/require_cookie"}]}]},
    {overlay, [{copy, "rel/hooks/require_cookie", "bin/hooks/require_cookie"}]}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod},
            {sys_config_src, "./config/prod_sys.config.src"}
        ]}
    ]},
    {test, [
        {erl_opts, [nowarn_export_all, warnings_as_errors, {i, "test/util"}]},
        {deps, [
            {meck, "1.2.0"}
        ]},
        {ct_opts, [{sys_config, "./config/dev_sys.config.src"}]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        {xref_extra_paths, ["test"]}
    ]}
]}.

{dialyzer, [{plt_apps, all_deps}]}.

%% Plugins for rebar3
{project_plugins, [
    {rebar3_nova, "~> 0.13"},
    {rebar3_kura, "~> 0.16"},
    {erlfmt, "~>1.7"}
]}.

%% Generate migrations from schema changes before the Erlang sources compile
{provider_hooks, [
    {pre, [{compile, {kura, compile}}]}
]}.

{erlfmt, [
    write,
    {files, [
        "rebar.config",
        "src/*.app.src",
        "src/**/{*.erl, *.hrl}",
        "test/**/{*.erl, *.hrl}"
    ]},
    {exclude_files, ["config/vm.args.src", "config/prod_sys.config.src", "src/migrations/*.erl"]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

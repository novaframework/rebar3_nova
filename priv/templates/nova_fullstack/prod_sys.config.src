%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-

[
 {kernel, [
     {logger_level, info},
     {logger, [
         {handler, default, logger_std_h, #{
             level => error,
             config => #{file => "log/erlang.log"}
         }}
     ]}
 ]},
 {nova, [
     {use_stacktrace, false},
     {environment, prod},
     {cowboy_configuration, #{
         port => 8080,
         middleware_handlers => [
             arizona_cowboy_middleware,
             nova_router,
             nova_plugin_handler,
             nova_security_handler,
             nova_handler,
             nova_plugin_handler
         ]
     }},
     {bootstrap_application, {{name}}},
     {plugins, [
         {pre_request, nova_request_plugin, #{decode_json_body => true}}
     ]}
 ]},
 {arizona_nova, [
     %% These routes are served by arizona_cowboy_middleware, before nova_router,
     %% so the global Nova plugins (CSRF, auth, headers, otel) do not run on them.
     {routes, [
         {live, ~"/", {{name}}_home_live, #{layouts => [{ {{name}}_layout, render}]}},
         {ws, ~"/live/ws", #{}},
         {asset, ~"/assets/arizona", {priv_dir, arizona, "static/assets/js"}}
     ]}
 ]},
 {kura, [
     %% TLS to PostgreSQL is on unless DB_SSL=false, which is only for a
     %% database on the same host or a private network. minato verifies the
     %% server certificate against the OS trust store and checks the hostname;
     %% for a private CA, add ssl_options => [{cacertfile, "..."}] to the repo.
     %% The top-level ssl is for creating the database, the repo's for the pool.
     {ssl, ${DB_SSL:-true}},
     {repos, #{
         {{name}}_repo => #{
             backend => kura_backend_postgres,
             host => "${DB_HOST}",
             port => ${DB_PORT:-5432},
             database => "${DB_NAME}",
             user => "${DB_USER}",
             password => "${DB_PASSWORD}",
             pool_size => ${DB_POOL_SIZE:-10},
             ssl => ${DB_SSL:-true}
         }
     }}
 ]}
].

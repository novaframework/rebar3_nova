%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-

[
 {kernel, [
           {logger_level, info},
           {logger,
            [{handler, default, logger_std_h,
              #{level => error,
                config => #{file => "log/erlang.log"}}}
            ]}
          ]},
 {nova, [
         {use_stacktrace, false},
         {environment, prod},
         %% Signs session ids and CSRF tokens on a Nova later than 0.18, which
         %% does not start with SECRET_KEY_BASE unset. Make one with
         %% base64:encode(crypto:strong_rand_bytes(48)). in an Erlang shell, or
         %% openssl rand -base64 48, and give every node the same one.
         {secret_key_base, <<"${SECRET_KEY_BASE}">>},
         {cowboy_configuration, #{
                                  port => 8080
                                 }},
         {bootstrap_application, {{name}}}, %% Bootstraps the application
         %% Plugins is written on form {RequestType, Module, Options, Priority}
         %% Priority is that the lowest number is executed first
         {plugins, [
                    {pre_request, nova_request_plugin, #{decode_json_body => true}}
                   ]}
        ]}
  %% Please change your app.src-file instead if you intend to add app-specific configurations
].
